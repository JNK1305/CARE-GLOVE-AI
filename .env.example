# Copy to .env for local setup; never commit filled-in secrets.
APP_ENV=local
SERVER_PORT=8080

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=careglove_db
DB_USERNAME=root
DB_PASSWORD=replace-with-your-existing-local-mysql-root-password

# Python Machine Learning Service
ML_SERVICE_URL=http://localhost:8001
ML_CONNECT_TIMEOUT_MS=2000
ML_READ_TIMEOUT_MS=5000
ALERT_PERSISTENCE_WINDOWS=3
ALERT_RECOVERY_WINDOWS=3
ALERT_COOLDOWN_SECONDS=900

# Continuous Monitoring
MONITORING_INTERVAL_SECONDS=15
MONITORING_STALE_AFTER_SECONDS=45

# Firebase Realtime Database Ingestion
CAREGLOVE_FIREBASE_ENABLED=true
CAREGLOVE_FIREBASE_URL=https://worksafe-ai-63fc8-default-rtdb.firebaseio.com/
CAREGLOVE_FIREBASE_SENSOR_DATA_PATH=/sensorData
CAREGLOVE_FIREBASE_SENSOR_HISTORY_PATH=/sensorHistory
CAREGLOVE_FIREBASE_POLL_INTERVAL_SECONDS=15
CAREGLOVE_FIREBASE_AUTH_TOKEN=
CAREGLOVE_FIREBASE_DEFAULT_DEVICE=GLV-ICU-001
CAREGLOVE_FIREBASE_DEFAULT_PATIENT=CG-B2CC11AC158A
CAREGLOVE_FIREBASE_DEVICE_PATIENT_MAPPING=GLV-ICU-001:CG-B2CC11AC158A,GLV-ICU-002:CG-1042

# Security & CORS
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL_MINUTES=60
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080

